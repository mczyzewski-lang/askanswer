# --- Baza danych (PostgreSQL) ---
DATABASE_URL="postgresql://askby:askby@localhost:5432/askby?schema=public"

# --- Aplikacja ---
# Publiczny adres aplikacji (używany do generowania linków nagrań)
APP_URL="http://localhost:3000"
# Sekret do podpisywania sesji, linków do mediów i szyfrowania tokenów zaproszeń.
# Wygeneruj: openssl rand -base64 48
APP_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Konto administratora tworzone przez seed
ADMIN_EMAIL="admin@askby.local"
ADMIN_PASSWORD="askby-admin"

# --- ElevenLabs (tylko po stronie serwera, nigdy w kodzie klienta) ---
ELEVENLABS_API_KEY=""
# Domyślny głos lektora (można zmienić w ustawieniach projektu)
ELEVENLABS_VOICE_ID="pNInz6obpgDQGcFmaJgB"
# Model TTS obsługujący język polski
ELEVENLABS_TTS_MODEL="eleven_v4"
# Model transkrypcji
ELEVENLABS_STT_MODEL="scribe_v2"
ELEVENLABS_BASE_URL="https://api.elevenlabs.io"

# --- Higgsfield: AI przebitki wideo w Studio (tylko po stronie serwera) ---
# KEY_ID:KEY_SECRET z panelu API Higgsfield
HIGGSFIELD_CREDENTIALS=""
HIGGSFIELD_MODEL="kling-video/v3.0/pro/text-to-video"
# ilustracje w tle infografik
HIGGSFIELD_IMAGE_MODEL="flux-pro/kontext/max/text-to-image"

# --- Claude: propozycje scen i promptów na podstawie wypowiedzi eksperta (opcjonalnie) ---
ANTHROPIC_API_KEY=""

# --- Przechowywanie mediów ---
# "local" = prywatny katalog na dysku (domyślnie ./storage), "s3" = S3/MinIO
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="askby-media"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"

# --- Narzędzia ---
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
# Maksymalny rozmiar pojedynczego nagrania (MB)
MAX_UPLOAD_MB="1024"
# Ważność linków nagraniowych (dni)
INVITATION_TTL_DAYS="30"
