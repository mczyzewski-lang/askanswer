# --- Baza danych (PostgreSQL) ---
DATABASE_URL="postgresql://askby:askby@localhost:5432/askby?schema=public"

# --- Aplikacja ---
# Publiczny adres aplikacji (używany do generowania linków nagrań)
APP_URL="http://localhost:3000"
# Sekret do podpisywania sesji, linków do mediów i szyfrowania tokenów zaproszeń.
# Wygeneruj: openssl rand -base64 48
APP_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Konto administratora tworzone przez seed
ADMIN_EMAIL="admin@askby.local"
ADMIN_PASSWORD="askby-admin"

# --- ElevenLabs (tylko po stronie serwera, nigdy w kodzie klienta) ---
ELEVENLABS_API_KEY=""
# Domyślny głos lektora (można zmienić w ustawieniach projektu)
ELEVENLABS_VOICE_ID="pNInz6obpgDQGcFmaJgB"
# Model TTS obsługujący język polski
ELEVENLABS_TTS_MODEL="eleven_v4"
# Model transkrypcji
ELEVENLABS_STT_MODEL="scribe_v2"
ELEVENLABS_BASE_URL="https://api.elevenlabs.io"

# --- Higgsfield: AI przebitki wideo w Studio (tylko po stronie serwera) ---
# KEY_ID:KEY_SECRET z panelu API Higgsfield
HIGGSFIELD_CREDENTIALS=""
HIGGSFIELD_MODEL="kling-video/v3.0/pro/text-to-video"
# ilustracje w tle infografik
HIGGSFIELD_IMAGE_MODEL="flux-pro/kontext/max/text-to-image"

# --- Claude: propozycje scen i promptów na podstawie wypowiedzi eksperta (opcjonalnie) ---
ANTHROPIC_API_KEY=""

# --- OpenAI: infografiki (tło albo cała grafika z tekstem) — opcjonalnie ---
OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL="gpt-image-2"
# jakość / rozmiar / liczba wariantów grafik (koszt): low | medium | high
OPENAI_IMAGE_QUALITY="medium"
OPENAI_IMAGE_LONG="1536"
ILLUSTRATION_VARIANTS="3"
# model tekstowy do scoringu treści (Ads Studio i skrypty z prompterem); przy błędzie modelu → gpt-4.1
OPENAI_TEXT_MODEL="gpt-5"

# --- Przechowywanie mediów ---
# "local" = prywatny katalog na dysku (domyślnie ./storage), "s3" = S3/MinIO
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="askby-media"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"

# --- Narzędzia ---
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
# Maksymalny rozmiar pojedynczego nagrania (MB)
MAX_UPLOAD_MB="1024"
# Ważność linków nagraniowych (dni)
INVITATION_TTL_DAYS="30"

# --- Social Media Studio: Upload-Post (planowanie i publikacja) ---
# Bez klucza studio działa w trybie DEMO (nic nie jest publikowane naprawdę).
UPLOAD_POST_API_KEY=""
UPLOAD_POST_BASE_URL="https://api.upload-post.com/api"
# Webhook: sekret do podpisu HMAC SHA-256 i/lub token w adresie (?token=…)
UPLOAD_POST_WEBHOOK_SECRET=""
UPLOAD_POST_WEBHOOK_TOKEN=""
# Nazwy nagłówków webhooka (jeśli Upload-Post używa innych — ustaw tutaj)
UPLOAD_POST_SIGNATURE_HEADER="x-upload-post-signature"
UPLOAD_POST_TIMESTAMP_HEADER="x-upload-post-timestamp"
UPLOAD_POST_DELIVERY_HEADER="x-upload-post-delivery"
# Wysyłaj external_id z każdym zleceniem (pole niepotwierdzone w SDK — domyślnie wyłączone)
UPLOAD_POST_SEND_EXTERNAL_ID="false"
# Wymuś tryb DEMO mimo klucza (np. środowisko testowe)
SOCIAL_DEMO_MODE="false"
# Dane DEMO przy pierwszym starcie bez klucza (false = nie wczytuj)
SOCIAL_SEED_DEMO="true"
# Maksymalny rozmiar filmu w bibliotece (MB) i co ile ms worker sprawdza terminy / stany
SOCIAL_MAX_UPLOAD_MB="4096"
SOCIAL_TICK_MS="60000"
